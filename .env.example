# Kopier til .env:  cp .env.example .env
# .env skal aldri legges i git. Alt under virker som det står, uten at du endrer noe, for lokal prøving.

# Hemmelig streng som signerer innloggingen. Minst 32 tegn. Bytt den hvis appen noen gang kjører for ekte:
#   openssl rand -hex 32
SESSION_SECRET=lokal-utvikling-bytt-meg-hvis-dette-kjorer-for-ekte

# Port serveren lytter på (nettsiden under utvikling ligger på 5173 og sender /api hit)
PORT=3000

# Mappen databasen ligger i
DATA_DIR=./data

# false: cookies uten Secure (nødvendig over vanlig http lokalt). true: alltid. auto: Secure bare over https.
COOKIE_SECURE=false

# Antall proxyer foran appen. 0 lokalt.
TRUST_PROXY=0

# debug, info, warn eller error
LOG_LEVEL=info

# Værvarsel over oppslagstavla henter fra et eksternt API (trenger nett). Tomme felt gir Oslo.
# Får du brannmurtrøbbel, eller vil du slippe nett: sett VAER_AKTIV=false, så virker resten av appen som vanlig.
VAER_AKTIV=true
# VAER_STED=Oslo
# VAER_LAT=59.9139
# VAER_LON=10.7522

# KI i appen (bare for voksne, ukeplan som PDF og middagsforslag). Av så lenge nøkkelen mangler, og
# resten av appen virker som vanlig. Vil du prøve den: lag en nøkkel i Anthropic Console, sett en forbruksgrense
# der, og legg nøkkelen her (aldri i git).
# ANTHROPIC_API_KEY=
# KI_AKTIV=true
# KI_MODELL=claude-sonnet-5-5
# KI_MAANEDSTAK_NOK=50
# KI_USD_NOK=11
